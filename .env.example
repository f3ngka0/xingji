# Copy to .env. Never commit live keys or credentials.
PUBLIC_HOST=example.com
PUBLIC_BASE_URL=https://example.com
HOST=0.0.0.0
PORT=3000
DB_PATH=/data/trips.sqlite
CORS_ORIGINS=
TRUST_PROXY_HOPS=1
REQUIRE_HTTPS=true

# AMap JS API key: browser-visible by design; restrict it to your domain in AMap.
# The JS API security code stays on the server and is injected by /_AMapService.
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
# 64 hex characters, generated once and preserved across redeployments.
SHARE_TOKEN_ENCRYPTION_KEY=

DEFAULT_SHARE_TTL_SECONDS=2592000
DATA_RETENTION_DAYS=90
DEFAULT_MAX_SHARE_SECONDS=86400
DEFAULT_SAMPLE_INTERVAL_SEC=300
