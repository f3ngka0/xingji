# Optional: AMap JavaScript API key restricted to the production website domain.
# AMap is used only when this key and the server proxy flag below are configured.
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_PROXY_ENABLED=false

# Local Vite development proxy target for /api and /_AMapService.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:3000
