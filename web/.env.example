# AMap JavaScript API key restricted to the production website domain.
# The corresponding AMap security service proxy is provided by the backend
# at same-origin /_AMapService; never put securityJsCode in browser code.
VITE_AMAP_JS_KEY=

# Local Vite development proxy target for /api and /_AMapService.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:3000
